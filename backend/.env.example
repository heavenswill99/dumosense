DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.yourdomain.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

DB_NAME=your_aiven_database
DB_USER=your_aiven_user
DB_PASSWORD=your_aiven_password
DB_HOST=your_aiven_host
DB_PORT=3306
# Optional if your Aiven connection requires a CA bundle:
# DB_SSL_CA=certs/ca.pem

CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Server-side only. Never put this key in the frontend environment.
RESEND_API_KEY=replace-with-your-resend-api-key
WAITLIST_FROM_EMAIL=hello@your-verified-domain.com
WAITLIST_FROM_NAME=DumoSense
WAITLIST_WEBSITE_URL=https://yourdomain.com
WAITLIST_ANON_RATE=5/hour
